{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar API (uvicorn)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application startup complete|Uvicorn running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Cifrar contraseña",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/scripts/encrypt_password.py",
        "encrypt",
        "${input:textoCifrar}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Descifrar contraseña",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/scripts/encrypt_password.py",
        "decrypt",
        "${input:textoDescifrar}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Aplicar migraciones (alembic upgrade head)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/alembic.exe",
      "args": [
        "upgrade",
        "head"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Generar migración (alembic revision --autogenerate)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/alembic.exe",
      "args": [
        "revision",
        "--autogenerate",
        "-m",
        "${input:migrationDescription}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Ejecutar pruebas (pytest)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pytest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "migrationDescription",
      "type": "promptString",
      "description": "Descripción de la migración (mensaje de alembic -m)",
      "default": "descripcion del cambio"
    },
    {
      "id": "textoCifrar",
      "type": "promptString",
      "description": "Texto a cifrar",
      "password": true
    },
    {
      "id": "textoDescifrar",
      "type": "promptString",
      "description": "Texto a descifrar"
    }
  ]
}
